# RESEND_API_KEY: API Key for sending contact-form lead notifications to jordancodespace@gmail.com.
# Optional — if missing, leads are logged server-side and the visitor submission still succeeds.
RESEND_API_KEY=

# ADMIN_PIN: Passcode for the /admin studio dashboard.
# Verified server-side against this value via a Server Action; a secure httpOnly
# session cookie (7-day expiry, SameSite=Strict) is issued on success.
# The PIN is never shipped to the browser. Set a strong value in production.
ADMIN_PIN=change-me

# MONGODB_URI: MongoDB Atlas connection string (REQUIRED).
# All data (invoices, quotes, projects, reviews, client portals, site config) is
# stored in MongoDB. The site will not function without this.
# Create a free M0 cluster at https://www.mongodb.com/cloud/atlas (no credit card),
# add a database user, set Network Access to "Allow access from anywhere" (0.0.0.0/0)
# for Vercel, then copy the mongodb+srv:// connection string from Connect → Drivers.
# NEVER commit the real value — keep it only in .env.local / Vercel env vars.
MONGODB_URI=
